library(tibble)
library(xml2)
library(magick)
# ================================
# Set base paths
# ================================
base_dir  <- "C:/Users/a2618/Desktop/All_KEGG_Genes/ALL_Human_Genes_KEGG/KEGG_Pathway_Based_Genes/Base"
data_dir  <- file.path(base_dir, "Pathway_View")
out_dir   <- file.path(data_dir, "FissionYeast")
imd_file  <- file.path(data_dir, "IMDs_Genes.xlsx")
orth_file <- file.path(data_dir, "Human_to_FissionYeast_Orthology_State.xlsx")
kegg_file <- file.path(data_dir, "KEGG_hsa_pathway_to_genes.xlsx")
if (!dir.exists(out_dir)) {
dir.create(out_dir, recursive = TRUE)
}
setwd(out_dir)
# ================================
# USER SETTINGS
# ================================
model_name  <- "FissionYeast"
rect_types  <- c("rectangle", "roundrectangle")
low_col     <- "royalblue"
mid_col     <- "#FFF176"
high_col    <- "#FFD600"
border_col  <- "red"
# ================================
# Read files
# ================================
orth     <- readxl::read_excel(orth_file)
kegg_tbl <- readxl::read_excel(kegg_file)
imd_tbl  <- readxl::read_excel(imd_file)
names(orth)     <- trimws(names(orth))
names(kegg_tbl) <- trimws(names(kegg_tbl))
names(imd_tbl)  <- trimws(names(imd_tbl))
# ================================
# Check columns
# ================================
if (!"Human Symbol" %in% names(orth)) {
stop("Column 'Human Symbol' not found in Human_to_FissionYeast_Orthology_State.xlsx")
}
if (!"Pathway_KEGG_ID" %in% names(kegg_tbl)) {
stop("Column 'Pathway_KEGG_ID' not found in KEGG_hsa_pathway_to_genes.xlsx")
}
if (!"Human_Gene_Symbol" %in% names(kegg_tbl)) {
stop("Column 'Human_Gene_Symbol' not found in KEGG_hsa_pathway_to_genes.xlsx")
}
imd_col_candidates <- c("Human_Gene_Symbol", "Human Symbol", "Human_Symbol", "Gene", "Gene Symbol", "Symbol")
imd_col <- imd_col_candidates[imd_col_candidates %in% names(imd_tbl)][1]
if (is.na(imd_col) || length(imd_col) == 0) {
stop(
paste0(
"Could not find a human gene column in IMDs_Genes.xlsx. ",
"Please rename the gene column to one of: ",
paste(imd_col_candidates, collapse = ", ")
)
)
}
# ================================
# Orthology human genes
# ================================
orth_genes <- orth %>%
dplyr::mutate(Human_Symbol = as.character(`Human Symbol`)) %>%
dplyr::filter(!is.na(Human_Symbol), Human_Symbol != "") %>%
dplyr::distinct(Human_Symbol)
# ================================
# IMD human genes
# ================================
imd_genes <- imd_tbl %>%
dplyr::mutate(Human_Symbol = as.character(.data[[imd_col]])) %>%
dplyr::filter(!is.na(Human_Symbol), Human_Symbol != "") %>%
dplyr::distinct(Human_Symbol)
cat("IMD gene column detected:", imd_col, "\n")
cat("Number of IMD genes:", nrow(imd_genes), "\n")
# ================================
# KEGG pathway table
# ================================
kegg_tbl2 <- kegg_tbl %>%
dplyr::mutate(
Pathway_KEGG_ID = as.character(Pathway_KEGG_ID),
Human_Symbol    = as.character(Human_Gene_Symbol)
) %>%
dplyr::filter(
!is.na(Pathway_KEGG_ID), Pathway_KEGG_ID != "",
!is.na(Human_Symbol), Human_Symbol != ""
) %>%
dplyr::distinct(Pathway_KEGG_ID, Human_Symbol)
all_pathways <- sort(unique(kegg_tbl2$Pathway_KEGG_ID))
cat("Total pathways found:", length(all_pathways), "\n")
# ================================
# KEGG human gene -> EC mapping
# ================================
cat("Downloading KEGG human gene-to-enzyme mapping...\n")
kegg_hsa_ec <- KEGGREST::keggLink("enzyme", "hsa")
gene_ec_df <- tibble::tibble(
hsa_id = names(kegg_hsa_ec),
ec_id  = unname(kegg_hsa_ec)
) %>%
dplyr::mutate(
ENTREZID = sub("^hsa:", "", hsa_id),
EC       = sub("^ec:", "", ec_id)
) %>%
dplyr::select(ENTREZID, EC) %>%
dplyr::distinct()
# ================================
# SYMBOL -> ENTREZ mapping once
# ================================
all_symbols <- sort(unique(c(kegg_tbl2$Human_Symbol, imd_genes$Human_Symbol)))
cat("Mapping human gene symbols to Entrez IDs...\n")
symbol2entrez <- AnnotationDbi::select(
org.Hs.eg.db,
keys    = all_symbols,
columns = c("SYMBOL", "ENTREZID"),
keytype = "SYMBOL"
) %>%
dplyr::distinct() %>%
dplyr::filter(!is.na(ENTREZID), !is.na(SYMBOL))
imd_entrez <- symbol2entrez %>%
dplyr::filter(SYMBOL %in% imd_genes$Human_Symbol) %>%
dplyr::pull(ENTREZID) %>%
unique() %>%
as.character()
cat("Mapped IMD Entrez IDs:", length(imd_entrez), "\n")
# ================================
# Helper: KEGG download
# ================================
download_kegg_files <- function(pathway_id, png_file, xml_file) {
png_url <- paste0("https://rest.kegg.jp/get/", pathway_id, "/image")
xml_url <- paste0("https://rest.kegg.jp/get/", pathway_id, "/kgml")
utils::download.file(png_url, destfile = png_file, mode = "wb", quiet = TRUE)
utils::download.file(xml_url, destfile = xml_file, mode = "wb", quiet = TRUE)
if (!file.exists(png_file)) stop("Failed to download KEGG PNG.")
if (!file.exists(xml_file)) stop("Failed to download KEGG KGML.")
}
# ================================
# Helper: parse rectangle nodes
# ================================
parse_kegg_rect_nodes <- function(xml_file, rect_types = c("rectangle", "roundrectangle")) {
doc <- xml2::read_xml(xml_file)
entry_nodes <- xml2::xml_find_all(doc, ".//entry")
if (length(entry_nodes) == 0) {
stop("No <entry> nodes found in KGML.")
}
out_list <- vector("list", length(entry_nodes))
for (i in seq_along(entry_nodes)) {
entry <- entry_nodes[[i]]
entry_id   <- xml2::xml_attr(entry, "id")
entry_name <- xml2::xml_attr(entry, "name")
entry_type <- xml2::xml_attr(entry, "type")
graphics <- xml2::xml_find_first(entry, ".//graphics")
if (inherits(graphics, "xml_missing")) next
g_type <- xml2::xml_attr(graphics, "type")
g_name <- xml2::xml_attr(graphics, "name")
x      <- suppressWarnings(as.numeric(xml2::xml_attr(graphics, "x")))
y      <- suppressWarnings(as.numeric(xml2::xml_attr(graphics, "y")))
width  <- suppressWarnings(as.numeric(xml2::xml_attr(graphics, "width")))
height <- suppressWarnings(as.numeric(xml2::xml_attr(graphics, "height")))
out_list[[i]] <- data.frame(
entry_id      = ifelse(is.na(entry_id), NA_character_, entry_id),
entry_name    = ifelse(is.na(entry_name), NA_character_, entry_name),
entry_type    = ifelse(is.na(entry_type), NA_character_, entry_type),
graphics_name = ifelse(is.na(g_name), NA_character_, g_name),
graphics_type = ifelse(is.na(g_type), NA_character_, g_type),
x = x, y = y, width = width, height = height,
stringsAsFactors = FALSE
)
}
nodes <- dplyr::bind_rows(out_list)
nodes %>%
dplyr::filter(
!is.na(graphics_type),
graphics_type %in% rect_types,
!is.na(x), !is.na(y), !is.na(width), !is.na(height)
)
}
# ================================
# Helper: expand KEGG ids
# ================================
expand_kegg_ids <- function(nodes_df) {
expanded <- vector("list", nrow(nodes_df))
for (i in seq_len(nrow(nodes_df))) {
ids <- unlist(strsplit(nodes_df$entry_name[i], "\\s+"))
ids <- ids[ids != ""]
if (length(ids) == 0) next
expanded[[i]] <- data.frame(
entry_id      = nodes_df$entry_id[i],
graphics_name = nodes_df$graphics_name[i],
graphics_type = nodes_df$graphics_type[i],
x             = nodes_df$x[i],
y             = nodes_df$y[i],
width         = nodes_df$width[i],
height        = nodes_df$height[i],
kegg_id       = ids,
stringsAsFactors = FALSE
)
}
dplyr::bind_rows(expanded)
}
# ================================
# Helper: legend
# ================================
add_custom_legend <- function(png_file,
out_file,
low_col = "royalblue",
mid_col = "#FFF176",
high_col = "#FFD600") {
img  <- magick::image_read(png_file)
info <- magick::image_info(img)
img_w <- info$width[1]
legend_w <- 140
legend_h <- 42
legend_img <- magick::image_graph(
width = legend_w,
height = legend_h,
bg = "transparent",
res = 144
)
par(mar = c(0, 0, 0, 0))
plot.new()
plot.window(xlim = c(0, 1), ylim = c(0, 1), xaxs = "i", yaxs = "i")
cols <- grDevices::colorRampPalette(c(low_col, mid_col, high_col))(512)
x0 <- 0.10
x1 <- 0.90
y0 <- 0.48
y1 <- 0.74
for (i in seq_along(cols)) {
xi0 <- x0 + (i - 1) / length(cols) * (x1 - x0)
xi1 <- x0 + i / length(cols) * (x1 - x0)
rect(xi0, y0, xi1, y1, col = cols[i], border = NA)
}
rect(x0, y0, x1, y1, border = "black", lwd = 0.8)
text(x0,          0.10, "0%",   adj = c(0.5, 0.5), cex = 0.2)
text((x0 + x1)/2, 0.10, "50%",  adj = c(0.5, 0.5), cex = 0.2)
text(x1,          0.10, "100%", adj = c(0.5, 0.5), cex = 0.2)
dev.off()
final_img <- magick::image_composite(
img,
legend_img,
offset = paste0("+", img_w - legend_w - 35, "+16")
)
magick::image_write(final_img, path = out_file, format = "png")
}
# ================================
# Helper: color function
# ================================
col_fun <- grDevices::colorRampPalette(c(low_col, mid_col, high_col))
value_to_rgb <- function(v, min_val = 0, max_val = 100, n = 512) {
if (is.na(v) || !is.finite(v)) return(rep(NA_real_, 3))
v <- max(min_val, min(max_val, v))
idx <- round((v - min_val) / (max_val - min_val) * (n - 1)) + 1
cols <- col_fun(n)
rgb_mat <- grDevices::col2rgb(cols)
as.numeric(rgb_mat[, idx]) / 255
}
# ================================
# Helper: recolor rectangles
#   - all rectangle blocks -> white
#   - matched blocks -> colored
#   - only matched blocks -> red border
# ================================
recolor_rect_backgrounds <- function(png_file, node_tbl, out_file,
border_col = "red",
border_lwd = 2,
bg_tol = 0.18,
green_rule = TRUE) {
img <- png::readPNG(png_file)
if (length(dim(img)) != 3 || dim(img)[3] < 3) {
stop("PNG image must have at least 3 channels.")
}
img_h <- dim(img)[1]
img_w <- dim(img)[2]
rgb_dist <- function(r, g, b, tr, tg, tb) {
sqrt((r - tr)^2 + (g - tg)^2 + (b - tb)^2)
}
target_green <- c(0.85, 0.97, 0.85)
all_nodes <- node_tbl
colored_nodes <- node_tbl %>%
dplyr::filter(!is.na(percent), is.finite(percent))
get_bg_mask <- function(rr, gg, bb) {
dist_green <- rgb_dist(rr, gg, bb, target_green[1], target_green[2], target_green[3])
is_light   <- (rr > 0.65 & gg > 0.65 & bb > 0.55)
is_greenish <- (gg >= rr - 0.03 & gg >= bb - 0.03)
if (green_rule) {
dist_green <= bg_tol | (is_light & is_greenish)
} else {
dist_green <= bg_tol
}
}
# STEP 1: all rectangle backgrounds -> white
if (nrow(all_nodes) > 0) {
for (i in seq_len(nrow(all_nodes))) {
x_left   <- max(1, round(all_nodes$x[i] - all_nodes$width[i]  / 2))
x_right  <- min(img_w, round(all_nodes$x[i] + all_nodes$width[i]  / 2))
y_top    <- max(1, round(all_nodes$y[i] - all_nodes$height[i] / 2))
y_bottom <- min(img_h, round(all_nodes$y[i] + all_nodes$height[i] / 2))
if (x_left >= x_right || y_top >= y_bottom) next
rr <- img[y_top:y_bottom, x_left:x_right, 1]
gg <- img[y_top:y_bottom, x_left:x_right, 2]
bb <- img[y_top:y_bottom, x_left:x_right, 3]
mask <- get_bg_mask(rr, gg, bb)
img[y_top:y_bottom, x_left:x_right, 1][mask] <- 1
img[y_top:y_bottom, x_left:x_right, 2][mask] <- 1
img[y_top:y_bottom, x_left:x_right, 3][mask] <- 1
}
}
# STEP 2: matched nodes -> recolor
if (nrow(colored_nodes) > 0) {
for (i in seq_len(nrow(colored_nodes))) {
fill_rgb <- value_to_rgb(colored_nodes$percent[i])
x_left   <- max(1, round(colored_nodes$x[i] - colored_nodes$width[i]  / 2))
x_right  <- min(img_w, round(colored_nodes$x[i] + colored_nodes$width[i]  / 2))
y_top    <- max(1, round(colored_nodes$y[i] - colored_nodes$height[i] / 2))
y_bottom <- min(img_h, round(colored_nodes$y[i] + colored_nodes$height[i] / 2))
if (x_left >= x_right || y_top >= y_bottom) next
rr <- img[y_top:y_bottom, x_left:x_right, 1]
gg <- img[y_top:y_bottom, x_left:x_right, 2]
bb <- img[y_top:y_bottom, x_left:x_right, 3]
is_whiteish <- (rr > 0.92 & gg > 0.92 & bb > 0.92)
img[y_top:y_bottom, x_left:x_right, 1][is_whiteish] <- fill_rgb[1]
img[y_top:y_bottom, x_left:x_right, 2][is_whiteish] <- fill_rgb[2]
img[y_top:y_bottom, x_left:x_right, 3][is_whiteish] <- fill_rgb[3]
}
}
png::writePNG(img, target = out_file)
# STEP 3: only matched nodes -> red border
img2 <- png::readPNG(out_file)
png(filename = out_file, width = img_w, height = img_h, bg = "white")
grid::grid.raster(img2, x = 0.5, y = 0.5, width = 1, height = 1, interpolate = FALSE)
if (nrow(colored_nodes) > 0) {
for (i in seq_len(nrow(colored_nodes))) {
x_npc <- colored_nodes$x[i] / img_w
y_npc <- 1 - (colored_nodes$y[i] / img_h)
w_npc <- colored_nodes$width[i] / img_w
h_npc <- colored_nodes$height[i] / img_h
grid::grid.rect(
x = x_npc,
y = y_npc,
width  = w_npc,
height = h_npc,
gp = grid::gpar(fill = NA, col = border_col, lwd = border_lwd)
)
}
}
dev.off()
}
# ================================
# Loop through all pathways
# ================================
summary_list <- list()
for (pw in all_pathways) {
cat("\n===============================\n")
cat("Processing pathway:", pw, "\n")
tryCatch({
pw_tbl <- kegg_tbl2 %>%
dplyr::filter(Pathway_KEGG_ID == pw) %>%
dplyr::distinct(Human_Symbol)
if (nrow(pw_tbl) == 0) {
cat("No genes found, skipped.\n")
next
}
pw_symbol2entrez <- pw_tbl %>%
dplyr::inner_join(symbol2entrez, by = c("Human_Symbol" = "SYMBOL")) %>%
dplyr::distinct(Human_Symbol, ENTREZID)
if (nrow(pw_symbol2entrez) == 0) {
cat("No Entrez IDs mapped, skipped.\n")
next
}
# direct gene-node layer
pw_gene_tbl <- pw_tbl %>%
dplyr::left_join(symbol2entrez, by = c("Human_Symbol" = "SYMBOL")) %>%
dplyr::mutate(
ENTREZID = as.character(ENTREZID),
is_imd   = Human_Symbol %in% imd_genes$Human_Symbol,
in_model = Human_Symbol %in% orth_genes$Human_Symbol
) %>%
dplyr::distinct(Human_Symbol, ENTREZID, is_imd, in_model)
gene_node_tbl <- pw_gene_tbl %>%
dplyr::filter(is_imd, !is.na(ENTREZID), ENTREZID != "") %>%
dplyr::mutate(percent = ifelse(in_model, 100, 0)) %>%
dplyr::group_by(ENTREZID) %>%
dplyr::summarise(percent = max(percent, na.rm = TRUE), .groups = "drop")
# EC layer
pw_ec <- pw_symbol2entrez %>%
dplyr::inner_join(gene_ec_df, by = "ENTREZID") %>%
dplyr::distinct(Human_Symbol, ENTREZID, EC)
pw_ec_imd <- pw_ec %>%
dplyr::mutate(ENTREZID = as.character(ENTREZID)) %>%
dplyr::filter(ENTREZID %in% imd_entrez)
ec_percent <- pw_ec_imd %>%
dplyr::mutate(in_Human_to_FissionYeast = Human_Symbol %in% orth_genes$Human_Symbol) %>%
dplyr::group_by(EC) %>%
dplyr::summarise(
total_genes   = dplyr::n_distinct(Human_Symbol),
present_genes = dplyr::n_distinct(Human_Symbol[in_Human_to_FissionYeast]),
percent       = ifelse(total_genes > 0, 100 * present_genes / total_genes, NA_real_),
.groups = "drop"
) %>%
dplyr::arrange(dplyr::desc(percent), EC)
write.csv(
ec_percent,
file = file.path(out_dir, paste0(pw, "_enzyme_percentage_Human_to_FissionYeast_IMD_only.csv")),
row.names = FALSE
)
ec_gene_tbl <- pw_ec_imd %>%
dplyr::left_join(ec_percent %>% dplyr::select(EC, percent), by = "EC") %>%
dplyr::group_by(ENTREZID) %>%
dplyr::summarise(percent = max(percent, na.rm = TRUE), .groups = "drop") %>%
dplyr::filter(!is.na(percent), is.finite(percent)) %>%
dplyr::mutate(ENTREZID = as.character(ENTREZID))
gene_percent <- dplyr::bind_rows(
gene_node_tbl,
ec_gene_tbl
) %>%
dplyr::group_by(ENTREZID) %>%
dplyr::summarise(percent = max(percent, na.rm = TRUE), .groups = "drop") %>%
dplyr::filter(!is.na(ENTREZID), ENTREZID != "", !is.na(percent), is.finite(percent))
if (nrow(gene_percent) == 0) {
cat("No gene percentage data for coloring, skipped.\n")
next
}
write.csv(
gene_percent,
file = file.path(out_dir, paste0(pw, "_combined_gene_values_Human_to_FissionYeast_IMD_only.csv")),
row.names = FALSE
)
# download KEGG files
raw_png_file    <- file.path(out_dir, paste0(pw, "_KEGG_raw.png"))
kgml_file       <- file.path(out_dir, paste0(pw, ".xml"))
tmp_png_file    <- file.path(out_dir, paste0(pw, "_tmp_colored.png"))
final_png       <- file.path(out_dir, paste0(pw, "_Human_to_FissionYeast_IMD_only_colored.png"))
node_table_file <- file.path(out_dir, paste0(pw, "_rectangle_node_table.csv"))
download_kegg_files(pw, raw_png_file, kgml_file)
rect_nodes <- parse_kegg_rect_nodes(kgml_file, rect_types = rect_types)
if (nrow(rect_nodes) == 0) {
cat("No rectangle-like nodes found, skipped.\n")
next
}
node_ids <- expand_kegg_ids(rect_nodes)
gene_value_tbl <- gene_percent %>%
dplyr::mutate(kegg_id = paste0("hsa:", ENTREZID)) %>%
dplyr::select(kegg_id, percent)
ec_value_tbl <- ec_percent %>%
dplyr::mutate(kegg_id = paste0("ec:", EC)) %>%
dplyr::select(kegg_id, percent)
all_value_tbl <- dplyr::bind_rows(gene_value_tbl, ec_value_tbl)
node_value_tbl <- node_ids %>%
dplyr::left_join(all_value_tbl, by = "kegg_id") %>%
dplyr::group_by(entry_id, graphics_name, graphics_type, x, y, width, height) %>%
dplyr::summarise(
matched_ids = paste(unique(kegg_id[!is.na(percent)]), collapse = ";"),
percent     = ifelse(all(is.na(percent)), NA_real_, max(percent, na.rm = TRUE)),
.groups = "drop"
) %>%
dplyr::mutate(
matched_ids = ifelse(matched_ids == "", NA_character_, matched_ids)
)
write.csv(node_value_tbl, node_table_file, row.names = FALSE)
if (sum(!is.na(node_value_tbl$percent)) == 0) {
cat("No matched rectangle nodes to color, skipped.\n")
next
}
recolor_rect_backgrounds(
png_file    = raw_png_file,
node_tbl    = node_value_tbl,
out_file    = tmp_png_file,
border_col  = border_col,
border_lwd  = 2.2,
bg_tol      = 0.18,
green_rule  = TRUE
)
add_custom_legend(
png_file = tmp_png_file,
out_file = final_png,
low_col  = low_col,
mid_col  = mid_col,
high_col = high_col
)
temp_files <- c(raw_png_file, kgml_file, tmp_png_file)
temp_files <- temp_files[file.exists(temp_files)]
if (length(temp_files) > 0) {
file.remove(temp_files)
}
summary_list[[pw]] <- data.frame(
Pathway_KEGG_ID         = pw,
Input_Genes             = nrow(pw_tbl),
Entrez_Mapped           = nrow(pw_symbol2entrez),
EC_Mapped               = nrow(pw_ec),
IMD_EC_Mapped           = nrow(pw_ec_imd),
Colored_IMD_Genes       = nrow(gene_percent),
Rectangle_Nodes         = nrow(rect_nodes),
Matched_Rectangle_Nodes = sum(!is.na(node_value_tbl$percent)),
Output_Figure           = basename(final_png),
stringsAsFactors        = FALSE
)
cat("Finished:", pw, "\n")
}, error = function(e) {
cat("Error in", pw, ":", conditionMessage(e), "\n")
})
}
# ================================
# Save summary
# ================================
if (length(summary_list) > 0) {
summary_df <- dplyr::bind_rows(summary_list)
write.csv(
summary_df,
file = file.path(out_dir, "FissionYeast_rectangle_overlay_summary.csv"),
row.names = FALSE
)
cat("\nAll done. Summary saved to:\n", file.path(out_dir, "FissionYeast_rectangle_overlay_summary.csv"), "\n")
} else {
cat("\nNo pathway figures were successfully generated.\n")
}
